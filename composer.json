{
    "name": "vagkaefer/cms-filament",
    "description": "Painel administrativo Filament 5 reutilizável: usuários, cargos/permissões, auditoria, backups, configurações e MFA nativo.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/vagkaefer/cms-filament",
    "keywords": [
        "laravel",
        "filament",
        "cms",
        "admin",
        "permissions",
        "audit",
        "backup"
    ],
    "authors": [
        {
            "name": "Vagner Kaefer",
            "email": "vagner.ks2@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "achyutn/filament-log-viewer": "^2.5",
        "filament/filament": "^5.0",
        "owen-it/laravel-auditing": "^14.0",
        "pxlrbt/filament-environment-indicator": "^3.6",
        "shuvroroy/filament-spatie-laravel-backup": "^4.0",
        "spatie/laravel-permission": "^8.0",
        "stechstudio/filament-impersonate": "^5.0",
        "tapp/filament-auditing": "^4.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^11.0",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "VagKaefer\\CmsFilament\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "VagKaefer\\CmsFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VagKaefer\\CmsFilament\\Providers\\CmsFilamentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:test": "pint --test",
        "stan": "phpstan analyse --memory-limit=512M",
        "md": "phpmd src text phpmd.xml",
        "cs": "phpcs",
        "ci": [
            "@lint:test",
            "@cs",
            "@stan",
            "@md",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
